syntax = "v1"

info(
	title: "user-api"
	desc: "this is my entry point to go-zero"
	author: "Mr.satan"
	email: "17854230834@163.com"
	version: "1.0"
)
type UserInfo {
	NickName        string `json:"nickname"`
	Avatar          string `json:"avatar"`
	Gender          int64  `json:"gender"`
	Birthday        string `json:"birthday"`
	Region          string `json:"region"`
	Phone           string `json:"phone"`
	Openid          string `json:"openid"`
	HistoryPoints   int64  `json:"historyPoints"`
	AvailablePoints int64  `json:"availablePoints"`
}

type (
	LoginRes {
		LoginCode string `json:"loginCode"`
		Phone     string `json:"phone"`
	}
	NoPhoneLoginRes {
		LoginCode string `json:"loginCode"`
	}
	LoginRp {
		Userinfo     *UserInfo `json:"userInfo"`
		LoginSuccess bool      `json:"loginSuccess"`
		IsRebund     bool      `json:"isRebund"`
		IsNew        bool      `json:"isNew"`
		AccessToken  string    `json:"accessToken"`
		//		AccessExpire string    `json:"accessExpire"`
		//		RefreshAfter string    `json:"refreshAfter"`
	}
	LoginResp {
		Code string   `json:"code"`
		Msg  string   `json:"msg"`
		Data *LoginRp `json:"data"`
	}
)

type (
	GetUserInfoRes {
	}
	GetUserInfoRp {
		Userinfo *UserInfo `json:"userInfo"`
	}
	GetUserInfoResp {
		Code string         `json:"code"`
		Msg  string         `json:"msg"`
		Data *GetUserInfoRp `json:"data"`
	}
)
type (
	UpdateUserInfoRes { // 更新手机号，解绑手机号，注销账号都用这个接口
		NickName string `json:"nickname"`
		Avatar   string `json:"avatar"`
		Gender   int64  `json:"gender"`
		Birthday string `json:"birthday"`
		Region   string `json:"region"`
	}
	UpdateUserInfoRp {
		Userinfo *UserInfo `json:"userInfo"`
	}
	UpdateUserInfoResp {
		Code string            `json:"code"`
		Msg  string            `json:"msg"`
		Data *UpdateUserInfoRp `json:"data"`
	}
)

type (
	ReboundRes {
		LoginCode string `json:"loginCode"`
	}
	ReboundRp {
		Userinfo     *UserInfo `json:"userInfo"`
		AccessToken  string    `json:"accessToken"`
		AccessExpire string    `json:"accessExpire"`
		RefreshAfter string    `json:"refreshAfter"`
	}
	ReboundResp {
		Code string     `json:"code"`
		Msg  string     `json:"msg"`
		Data *ReboundRp `json:"data"`
	}
)
type (
	RefreshRes {
		Force bool `json:"force"`
	}
	RefreshResp {
		Code string `json:"code"`
		Msg  string `json:"msg"`
	}
	GetPhoneRes {
		PhoneCode string `json:"phoneCode"`
	}
	GetPhoneRp {
		Phone       string `json:"phone"`
		CountryCode string `json:"countryCode"`
	}
	GetPhoneResp {
		Code string      `json:"code"`
		Msg  string      `json:"msg"`
		Data *GetPhoneRp `json:"data"`
	}
)

type (
	WaterMark {
		Timestamp int64  `json:"timestamp"`
		Appid     string `json:"appid"`
	}
	PhoneInfo {
		PhoneNumber     string     `json:"phoneNumber"`
		PurePhoneNumber string     `json:"purePhoneNumber"`
		CountryCode     string     `json:"countryCode"`
		Watermark       *WaterMark `json:"watermark"`
	}
	PhoneStruct {
		Errcode   int        `json:"errcode"`
		Errmsg    string     `json:"errmsg"`
		Phoneinfo *PhoneInfo `json:"phone_info"`
	}
)

@server(
	group: refresh
	prefix : refresh
)
service user-api {
	@doc "刷新access_token"
	@handler refreshat
	post /refreshat (RefreshRes) returns (GetPhoneResp)
	@doc "探针"
	@handler probe
	get /probe () returns ()
}

@server(
	group: myuser
	prefix : user
)
service user-api {
	@doc "登录"
	@handler login
	post /login (LoginRes) returns (LoginResp)
	
	@doc "获取手机号"
	@handler getphone
	post /getphone (GetPhoneRes) returns (GetPhoneResp)
	
	@doc "无手机号登录"
	@handler nophonelogin
	post /nophonelogin (NoPhoneLoginRes) returns (LoginResp)
}

@server(
	group: myuser
	jwt : Auth
	prefix : user
)
service user-api {
	/*
	优先使用openid查询
	*/
	@doc "获取用户信息"
	@handler getinfo
	post /getinfo (GetUserInfoRes) returns (GetUserInfoResp)
	/*
	不管更新啥，都要全部传给我
	*/
	@doc "更新信息"
	@handler updateinfo
	post /updateinfo (UpdateUserInfoRes) returns (UpdateUserInfoResp)
	
	/*
	不管更新啥，都要全部传给我
	*/
	@doc "更新信息"
	@handler rebound
	post /rebound (ReboundRes) returns (ReboundResp)
}

type (
	MsgData {
		OrderKey      *OrderKey `json:"order_key"`
		LogisticsType int64     `json:"logistics_type"`
		//物流模式，发货方式枚举值：1、实体物流配送采用快递公司进行实体物流配送形式 2、同城配送 3、虚拟商品，虚拟商品，例如话费充值，点卡等，无实体配送形式 4、用户自提
		DeliveryMode int64 `json:"delivery_mode"`
		//	发货模式，发货模式枚举值：1、UNIFIED_DELIVERY（统一发货）2、SPLIT_DELIVERY（分拆发货） 示例值: UNIFIED_DELIVERY
		IsAllDelivered bool `json:"is_all_delivered"`
		//	分拆发货模式时必填，用于标识分拆发货模式下是否已全部发货完成，只有全部发货完成的情况下才会向用户推送发货完成通知。示例值: true/false
		ShippingList []*ShippingList `json:"shipping_list"`
		//	物流信息列表，发货物流单列表，支持统一发货（单个物流单）和分拆发货（多个物流单）两种模式，多重性: [1, 10]
		UploadTime string `json:"upload_time"`
		Payer      *Payer `json:"payer"`
	}
	Payer {
		Openid string `json:"openid"`
	}
	OrderKey {
		OrderNumberType int64  `json:"order_number_type"`
		TransactionId   string `json:"transaction_id"`
		Mchid           string `json:"mchid"`
		OutTradeNo      string `json:"out_trade_no"`
	}
	ShippingList {
		TrackingNo     string   `json:"tracking_no"`
		ExpressCompany string   `json:"express_company"`
		ItemDesc       string   `json:"item_desc"`
		Contact        *Contact `json:"contact"`
	}
	Contact {
		ConsignorContact string `json:"consignor_contact"`
		ReceiverContact  string `json:"receiver_contact"`
	}
)
type (
	MsgDelivering {
		TransactionId   string `json:"transaction_id"`
		MerchantId      string `json:"merchant_id"`
		SubMerchantId   string `json:"sub_merchant_id"`
		MerchantTradeNo string `json:"merchant_trade_no"`
	}
	MsgReturn {
		Errcode int64  `json:"errcode"`
		Errmsg  string `json:"errmsg"`
		Order   *Order `json:"order"`
	}
	Order {
		TransactionId string `json:"transaction_id"`
		OrderState    int64  `json:"order_state"`
		Openid        string `json:"openid"`
	}
)