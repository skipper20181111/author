syntax = "v1"

info(
	title: "user-api"
	desc: "this is my entry point to go-zero"
	author: "Mr.satan"
	email: "17854230834@163.com"
	version: "1.0"
)
type UserInfo {
	NickName string `json:"nickname"`
	Avatar   string `json:"avatar"`
	Gender   int64  `json:"gender"`
	Birthday string `json:"birthday"`
	Region   string `json:"region"`
	Phone    string `json:"phone"`
	Openid   string `json:"openid"`
}

type (
	LoginRes {
		LoginCode string `json:"loginCode"`
		Phone     string `json:"phone"`
	}
	LoginRp {
		Userinfo     UserInfo `json:"userInfo"`
		IsNew        int      `json:"isNew"`
		AccessToken  string   `json:"accessToken"`
		AccessExpire string   `json:"accessExpire"`
		RefreshAfter string   `json:"refreshAfter"`
	}
	LoginResp {
		Code string  `json:"code"`
		Msg  string  `json:"msg"`
		Data LoginRp `json:"data"`
	}
)

type (
	GetUserInfoRes {
		Phone  string `json:"phone"`
		Openid string `json:"openid"` // 我会优先用openid查找，找不到再用phone去查
	}
	GetUserInfoRp {
		Userinfo UserInfo `json:"userInfo"`
	}
	GetUserInfoResp {
		Code string        `json:"code"`
		Msg  string        `json:"msg"`
		Data GetUserInfoRp `json:"data"`
	}
)
type (
	UpdateUserInfoRes { // 更新手机号，解绑手机号，注销账号都用这个接口
		Openid   string `json:"openid"`
		NickName string `json:"nickname"`
		Avatar   string `json:"avatar"`
		Gender   int64  `json:"gender"`
		Birthday string `json:"birthday"`
		Region   string `json:"region"`
		Phone    string `json:"phone"`
	}
	UpdateUserInfoRp {
		Userinfo UserInfo `json:"userInfo"`
	}
	UpdateUserInfoResp {
		Code string           `json:"code"`
		Msg  string           `json:"msg"`
		Data UpdateUserInfoRp `json:"data"`
	}
)
type (
	UnboundRp {
		Userinfo     UserInfo `json:"userInfo"`
		AccessToken  string   `json:"accessToken"`
		AccessExpire string   `json:"accessExpire"`
		RefreshAfter string   `json:"refreshAfter"`
	}
	UnboundResp {
		Code string    `json:"code"`
		Msg  string    `json:"msg"`
		Data UnboundRp `json:"data"`
	}
)
type (
	RefreshRes {
		Force bool `json:"force"`
	}
	RefreshResp {
		Code string `json:"code"`
		Msg  string `json:"msg"`
	}
	GetPhoneRes {
		PhoneCode string `json:"phoneCode"`
	}
	GetPhoneRp {
		Phone string `json:"phone"`
	}
	GetPhoneResp {
		Code string      `json:"code"`
		Msg  string      `json:"msg"`
		Data *GetPhoneRp `json:"data"`
	}
)
@server(
	group: refresh
	prefix : refresh
)
service user-api {
	@doc "刷新access_token"
	@handler refreshat
	post /refreshat (RefreshRes) returns (GetPhoneResp)
}

@server(
	group: myuser
	prefix : user
)
service user-api {
	@doc "登录"
	@handler login
	post /login (GetPhoneRes) returns (LoginResp)
	
	@doc "获取手机号"
	@handler getphone
	post /getphone (LoginRes) returns (LoginResp)
}

@server(
	group: myuser
	jwt : Auth
	prefix : user
)
service user-api {
	/*
	优先使用openid查询
	*/
	@doc "获取用户信息"
	@handler getinfo
	post /getinfo (GetUserInfoRes) returns (GetUserInfoResp)
	/*
	不管更新啥，都要全部传给我
	*/
	@doc "更新信息"
	@handler updateinfo
	post /updateinfo (UpdateUserInfoRes) returns (UpdateUserInfoResp)
	
	/*
	不管更新啥，都要全部传给我
	*/
	@doc "更新信息"
	@handler unbound
	post /unbound (LoginRes) returns (UnboundResp)
}