syntax = "v1"

info(
	title: "user-api"
	desc: "this is my entry point to go-zero"
	author: "Mr.satan"
	email: "17854230834@163.com"
	version: "1.0"
)
type UserInfo {
	NickName   string `json:"nickname"`
	Avatar     string `json:"avatar"`
	Gender     int    `json:"gender"`
	Birthday   string `json:"birthday"`
	Region     string `json:"region"`
	Phone      string `json:"phone"`
	Openid     string `json:"openid"`
	Wechatbind int    `json:"wechatbind"`
	Effective  int    `json:"effective"`
}

type (
	LoginRes {
		LoginCode string `json:"loginCode"`
	}
	LoginRp {
		Userinfo     UserInfo `json:"userInfo"`
		IsNew        int      `json:"isNew"`
		AccessToken  string   `json:"accessToken"`
		AccessExpire string   `json:"accessExpire"`
		RefreshAfter string   `json:"refreshAfter"`
	}
	LoginResp {
		Code string  `json:"code"`
		Msg  string  `json:"msg"`
		Data LoginRp `json:"data"`
	}
)

type (
	GetUserInfoRes {
		Phone  string `json:"phone"`
		Openid string `json:"openid"` // 我会优先用openid查找，找不到再用phone去查
	}
	GetUserInfoRp {
		Userinfo UserInfo `json:"userInfo"`
	}
	GetUserInfoResp {
		Code string        `json:"code"`
		Msg  string        `json:"msg"`
		Data GetUserInfoRp `json:"data"`
	}
)
type (
	UpdateUserInfoRes { // 更新手机号，解绑手机号，注销账号都用这个接口
		Openid     string `json:"openid"`
		NickName   string `json:"nickname"`
		Avatar     string `json:"avatar"`
		Gender     int    `json:"gender"`
		Birthday   string `json:"birthday"`
		Region     string `json:"region"`
		Phone      string `json:"phone"`
		Wechatbind int    `json:"wechatbind"`
		Effective  int    `json:"effective"`
	}
	UpdateUserInfoRp {
		Userinfo UserInfo `json:"userInfo"`
	}
	UpdateUserInfoResp {
		Code string           `json:"code"`
		Msg  string           `json:"msg"`
		Data UpdateUserInfoRp `json:"data"`
	}
)
@server(
	group: myuser
	prefix : user
	//    middleware : Limit_count
	
)
service user-api {
	@doc "登录"
	@handler login
	post /login (LoginRes) returns (LoginResp)
	/*
	成功登录返回Code="10000"，Msg="登录成功，返回用户信息"
	调用wx登录接口失败返回{Code: "4004",Msg: 微信错误信息}
	
	*/
}

@server(
	group: myuser
	jwt :Auth
	prefix : user
)
service user-api {
	/*
	优先使用openid查询
	*/
	@doc "获取用户信息"
	@handler getinfo
	post /getinfo (GetUserInfoRes) returns (GetUserInfoResp)
	/*
	不管更新啥，都要全部传给我
	*/
	@doc "更新信息"
	@handler updateinfo
	post /updateinfo (UpdateUserInfoRes) returns (UpdateUserInfoResp)
}